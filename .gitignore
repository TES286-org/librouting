/target
**/__pycache__
**/*.pyc
**/.pytest_cache
bindings/lr-python/src/librouting/_generated_*.py
bindings/lr-python/build
bindings/lr-python/dist
bindings/lr-go/liblr_ffi.*
Cargo.lock.bak
*.swp
.idea/
.vscode/

# template build artifacts
templates/*/target
templates/*/Cargo.lock

# cargo-fuzz build artifacts. The auto-generated corpus under
# `fuzz/corpus/<target>/` grows in size as the fuzzer discovers new
# coverage paths; the small hand-picked seed inputs under
# `fuzz/seeds/<target>/` ARE committed (typically 5–10 inputs per
# target) and serve as the starting corpus that `cargo +nightly
# fuzz run` copies into `fuzz/corpus/` on first run.
fuzz/target
fuzz/artifacts
fuzz/coverage
fuzz/corpus

# CycloneDX SBOM files produced by `cargo cyclonedx`. The release
# workflow (`generate-sbom` job in `.github/workflows/release.yml`)
# regenerates these per release tag and attaches them to the GitHub
# release; a developer running `cargo cyclonedx` locally for a
# pre-release audit should not accidentally commit the output.
*.cdx.json
*.cdx.xml

worklog.md
